<%@ tag description="Page layout: composes the shared header, navigation bar and footer around the body" body-content="scriptless" trimDirectiveWhitespaces="false" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %><%@ attribute name="design" required="true" description="Name of the design: it selects what header, navigation bar, wrapper and footer are used" %><%--
  Designs (l_* variables):
    l_title, l_charset, l_software, l_contenttype, l_fonts, l_styles, l_scripts, l_embedded, l_extra  parameters of includes/header.jsp
    l_navbar, l_navhome, l_navclass                                                                  parameters of includes/navbar.jsp (empty: no navigation bar)
    l_wrapper                                                                                          attributes of the <div> around the body (empty: no wrapper)
    l_cookie                                                                                           "true" shows the cookie notice
    l_parts                                                                                            parameters of includes/footer.jsp
--%><c:set var="content" scope="request"><jsp:doBody/></c:set><c:set var="name" value="${designs[design]}"/><c:choose>
<c:when test="${name eq 'account'}"><c:set var="l_title" value="design_title_account"/><c:set var="l_software" value="version"/><c:set var="l_contenttype" value="true"/><c:set var="l_fonts" value="true"/><c:set var="l_styles" value="@bootstrap,@fa6,style,@prism"/><c:set var="l_scripts" value="script_jquery,@popper,@bootstrap,script_post,@prism"/><c:set var="l_embedded" value="true"/><c:set var="l_body" value="bg-light"/><c:set var="l_navbar" value="brand"/><c:set var="l_navhome" value="index_com"/><c:set var="l_navclass" value="bg-dark sticky-top"/><c:set var="l_wrapper" value='id="profilecontent" class="container-fluid bg-white shadow rounded p-3"'/><c:set var="l_parts" value="embedded"/></c:when>
<c:when test="${name eq 'account_error'}"><c:set var="l_title" value="design_title_account_error"/><c:set var="l_charset" value="true"/><c:set var="l_styles" value="@bootstrap,style,@fa4"/><c:set var="l_scripts" value="script_post"/><c:set var="l_body" value="bg-light"/><c:set var="l_navbar" value="brand"/><c:set var="l_navhome" value="index"/><c:set var="l_navclass" value="bg-dark mb-3"/><c:set var="l_wrapper" value='id="profilecontent" class="container-fluid bg-white shadow rounded p-3"'/></c:when>
<c:when test="${name eq 'account_error_napping'}"><c:set var="l_title" value="design_title_account_error"/><c:set var="l_charset" value="true"/><c:set var="l_styles" value="@bootstrap,style_napping,@fa4"/><c:set var="l_scripts" value="script_post"/><c:set var="l_navbar" value="brand"/><c:set var="l_navhome" value="index_com"/><c:set var="l_navclass" value="mb-3"/><c:set var="l_wrapper" value='id="profilecontent" style="background-color: #ffffff; margin: 0.5rem; padding: 1rem; border-radius: 0.5rem;"'/></c:when>
<c:when test="${name eq 'console'}"><c:set var="l_title" value="design_admin_title"/><c:set var="l_software" value="coolchat"/><c:set var="l_contenttype" value="true"/><c:set var="l_fonts" value="true"/><c:set var="l_styles" value="@bootstrap,style,@fa4"/><c:set var="l_scripts" value="script_jquery,@popper,@bootstrap,script_framekiller"/><c:set var="l_body" value="bg-light"/><c:set var="l_navbar" value="console"/><c:set var="l_wrapper" value='id="pagecontent" class="container-fluid pt-4"'/><c:set var="l_parts" value="legal"/></c:when>
<c:when test="${name eq 'frameset'}"><c:set var="l_title" value="design_title_welcome_chat"/><c:set var="l_charset" value="true"/><c:set var="l_fonts" value="true"/><c:set var="l_styles" value="@bootstrap,style,style_iframe,style_chat,style_colorpicker,style_nav,@fa4"/><c:set var="l_scripts" value="script_jquery,@popper,@bootstrap,script_emoji,script_colorpicker,script_window"/><c:set var="l_parts" value="chat"/></c:when>
<c:when test="${name eq 'frameset_community'}"><c:set var="l_title" value="design_title_napping_community"/><c:set var="l_software" value="coolchat"/><c:set var="l_contenttype" value="true"/><c:set var="l_fonts" value="true"/><c:set var="l_styles" value="@bootstrap,style,@fa4"/><c:set var="l_scripts" value="script_jquery,@popper,@bootstrap,script_framekiller"/><c:set var="l_navbar" value="community"/><c:set var="l_wrapper" value='id="pagecontent" class="container-fluid page-main"'/><c:set var="l_parts" value="legal,lang"/></c:when>
<c:when test="${name eq 'frameset_community_reg'}"><c:set var="l_title" value="design_title_napping_community"/><c:set var="l_software" value="coolchat"/><c:set var="l_contenttype" value="true"/><c:set var="l_fonts" value="true"/><c:set var="l_styles" value="@bootstrap,style,@fa6,@prism"/><c:set var="l_scripts" value="script_jquery,@popper,@bootstrap,script_post,@prism"/><c:set var="l_navbar" value="community_reg"/><c:set var="l_wrapper" value='id="pagecontent" class="container-fluid page-main"'/><c:set var="l_parts" value="legal,lang"/></c:when>
<c:when test="${name eq 'frameset_napping'}"><c:set var="l_title" value="design_title_welcome_chat"/><c:set var="l_charset" value="true"/><c:set var="l_fonts" value="true"/><c:set var="l_styles" value="@bootstrap,style_iframe,style_chat,style_napping,style_colorpicker,style_nav,@fa4"/><c:set var="l_scripts" value="script_jquery,@popper,@bootstrap,script_emoji,script_colorpicker,script_window"/><c:set var="l_parts" value="chat"/></c:when>
<c:when test="${name eq 'frameset_privchat'}"><c:set var="l_title" value="design_title_welcome_chat"/><c:set var="l_charset" value="true"/><c:set var="l_fonts" value="true"/><c:set var="l_styles" value="@bootstrap,style_privchat,style_iframe,style_chat_privchat,style_colorpicker,style_nav,@fa4"/><c:set var="l_scripts" value="script_jquery,@popper,@bootstrap,script_emoji,script_colorpicker,script_window"/><c:set var="l_parts" value="chat"/></c:when>
<c:when test="${name eq 'frameset_privchat_napping'}"><c:set var="l_title" value="design_title_welcome_chat"/><c:set var="l_charset" value="true"/><c:set var="l_fonts" value="true"/><c:set var="l_styles" value="@bootstrap,style_napping_privchat,style_iframe,style_chat_privchat_napping,style_colorpicker,style_nav,@fa4"/><c:set var="l_scripts" value="script_jquery,@popper,@bootstrap,script_emoji,script_colorpicker,script_window"/><c:set var="l_parts" value="chat"/></c:when>
<c:when test="${name eq 'info'}"><c:set var="l_title" value="design_title_info"/><c:set var="l_charset" value="true"/><c:set var="l_styles" value="@bootstrap,style,@fa4"/><c:set var="l_navbar" value="brand"/><c:set var="l_navclass" value="bg-dark sticky-top"/><c:set var="l_wrapper" value='id="profilecontent" class="container-fluid shadow rounded"'/><c:set var="l_parts" value="embedded"/><c:set var="l_extra">
    body, #profilecontent, #profilecontent * { color: #212529 !important; }
    body { background-color: #f8f9fa; }
    #profilecontent { background-color: #ffffff; padding: 1rem; }
    a { color: #0d6efd !important; }
    body.embedded nav.navbar { display: none !important; }
    body.embedded { padding-top: 0 !important; }
  </c:set></c:when>
<c:when test="${name eq 'link'}"><c:set var="l_title" value="design_title_redirect"/><c:set var="l_charset" value="true"/><c:set var="l_styles" value="@bootstrap,style,@fa4"/><c:set var="l_scripts" value="script_link"/><c:set var="l_body" value="bg-light"/><c:set var="l_navbar" value="brand"/><c:set var="l_navhome" value="index"/><c:set var="l_navclass" value="bg-dark mb-3"/><c:set var="l_wrapper" value='id="profilecontent" class="container-fluid bg-white shadow rounded p-3"'/></c:when>
<c:when test="${name eq 'message'}"><c:set var="l_title" value="design_title_message"/><c:set var="l_charset" value="true"/><c:set var="l_styles" value="@bootstrap,style,@fa4"/><c:set var="l_scripts" value="script_post"/><c:set var="l_body" value="bg-light"/><c:set var="l_navbar" value="brand"/><c:set var="l_navhome" value="index"/><c:set var="l_navclass" value="bg-dark mb-3"/><c:set var="l_wrapper" value='id="profilecontent" class="container-fluid bg-white shadow rounded p-3"'/></c:when>
<c:when test="${name eq 'message_error'}"><c:set var="l_title" value="design_title_message_error"/><c:set var="l_charset" value="true"/><c:set var="l_styles" value="@bootstrap,style,@fa4"/><c:set var="l_scripts" value="script_post"/><c:set var="l_body" value="bg-light"/><c:set var="l_navbar" value="brand"/><c:set var="l_navhome" value="index"/><c:set var="l_navclass" value="bg-dark mb-3"/><c:set var="l_wrapper" value='id="profilecontent" class="container-fluid bg-white shadow rounded p-3"'/></c:when>
<c:when test="${name eq 'napping'}"><c:set var="l_title" value="design_title_napping"/><c:set var="l_charset" value="true"/><c:set var="l_fonts" value="true"/><c:set var="l_styles" value="@bootstrap,style_napping,@fa4"/><c:set var="l_scripts" value="script_jquery,@popper,@bootstrap,script_framekiller"/><c:set var="l_navbar" value="brand"/><c:set var="l_navhome" value="index_com"/><c:set var="l_navclass" value="mb-3"/><c:set var="l_wrapper" value='id="pagecontent" class="container-fluid bg-white shadow rounded p-3" style="background-color: #ffffff;"'/></c:when>
<c:when test="${name eq 'napping_account'}"><c:set var="l_title" value="design_title_account"/><c:set var="l_software" value="version"/><c:set var="l_contenttype" value="true"/><c:set var="l_fonts" value="true"/><c:set var="l_styles" value="@bootstrap,style_napping,@prism"/><c:set var="l_scripts" value="script_jquery,@popper,@bootstrap,script_post,@prism"/><c:set var="l_embedded" value="true"/><c:set var="l_navbar" value="brand"/><c:set var="l_navhome" value="index_com"/><c:set var="l_navclass" value="mb-3"/><c:set var="l_wrapper" value='id="profilecontent" style="background-color: #ffffff; margin: 0.5rem; padding: 1rem; border-radius: 0.5rem;"'/><c:set var="l_parts" value="embedded"/></c:when>
<c:when test="${name eq 'napping_info'}"><c:set var="l_title" value="design_title_info"/><c:set var="l_charset" value="true"/><c:set var="l_styles" value="@bootstrap,style_napping,@fa4"/><c:set var="l_embedded" value="true"/><c:set var="l_navbar" value="brand"/><c:set var="l_navclass" value="mb-3"/><c:set var="l_wrapper" value='id="profilecontent" style="background-color: #ffffff; margin: 0.5rem; padding: 1rem; border-radius: 0.5rem;"'/><c:set var="l_parts" value="embedded"/></c:when>
<c:when test="${name eq 'napping_message'}"><c:set var="l_title" value="design_title_message"/><c:set var="l_charset" value="true"/><c:set var="l_styles" value="@bootstrap,style_napping,@fa4"/><c:set var="l_scripts" value="script_post"/><c:set var="l_navbar" value="brand"/><c:set var="l_navhome" value="index_com"/><c:set var="l_navclass" value="mb-3"/><c:set var="l_wrapper" value='id="profilecontent" style="background-color: #ffffff; margin: 0.5rem; padding: 1rem; border-radius: 0.5rem;"'/></c:when>
<c:when test="${name eq 'napping_message_error'}"><c:set var="l_title" value="design_title_message_error"/><c:set var="l_charset" value="true"/><c:set var="l_styles" value="@bootstrap,style_napping,@fa4"/><c:set var="l_scripts" value="script_post"/><c:set var="l_navbar" value="brand"/><c:set var="l_navhome" value="index_com"/><c:set var="l_navclass" value="mb-3"/><c:set var="l_wrapper" value='id="profilecontent" style="background-color: #ffffff; margin: 0.5rem; padding: 1rem; border-radius: 0.5rem;"'/></c:when>
<c:when test="${name eq 'napping_profile'}"><c:set var="l_title" value="design_title_profile"/><c:set var="l_charset" value="true"/><c:set var="l_styles" value="@bootstrap,@fa6,style_napping"/><c:set var="l_scripts" value="script_post"/><c:set var="l_embedded" value="true"/><c:set var="l_navbar" value="brand"/><c:set var="l_navclass" value="mb-3"/><c:set var="l_wrapper" value='id="profilecontent" class="container-fluid profile-napping-wrapper"'/><c:set var="l_parts" value="embedded"/></c:when>
<c:when test="${name eq 'profile'}"><c:set var="l_title" value="design_title_profile"/><c:set var="l_charset" value="true"/><c:set var="l_styles" value="@bootstrap,@fa6,style"/><c:set var="l_scripts" value="script_post"/><c:set var="l_embedded" value="true"/><c:set var="l_body" value="bg-light"/><c:set var="l_navbar" value="brand"/><c:set var="l_navclass" value="bg-dark mb-3"/><c:set var="l_wrapper" value='id="profilecontent" class="container-fluid"'/><c:set var="l_parts" value="embedded"/></c:when>
<c:when test="${name eq 'start'}"><c:set var="l_title" value="design_title_software"/><c:set var="l_software" value="coolchat"/><c:set var="l_contenttype" value="true"/><c:set var="l_fonts" value="true"/><c:set var="l_styles" value="@bootstrap,style,@fa4"/><c:set var="l_scripts" value="script_jquery,@popper,@bootstrap,script_framekiller"/><c:set var="l_navbar" value="guest"/><c:set var="l_wrapper" value='id="pagecontent" class="container-fluid page-main"'/><c:set var="l_parts" value="legal,lang,cookie"/><c:set var="l_cookie" value="true"/></c:when>
</c:choose><c:choose><c:when test="${empty l_title}"><html><head><title>404 Not Found</title></head><body><h1>404 Not Found</h1><p><b>Error: The requested design '${design}' does not exist!</b></p><hr><address>${SERVER_SOFTWARE} ${SERVER_VERSION}-${SERVER_STATUS}</address></body><html></c:when><c:otherwise><!DOCTYPE html>
<html lang="${lang}" data-theme="${theme eq 'dark' ? 'dark' : 'light'}"<c:if test="${fn:contains(name, 'napping')}"> data-room-colors="true"</c:if>>
<head>
<jsp:include page="/WEB-INF/jsp/includes/header.jsp">
  <jsp:param name="title" value="${l_title}"/>
  <jsp:param name="charset" value="${l_charset}"/>
  <jsp:param name="software" value="${l_software}"/>
  <jsp:param name="contenttype" value="${l_contenttype}"/>
  <jsp:param name="fonts" value="${l_fonts}"/>
  <jsp:param name="styles" value="${l_styles}"/>
  <jsp:param name="scripts" value="${l_scripts}"/>
  <jsp:param name="embedded" value="${l_embedded}"/>
</jsp:include>
<c:if test="${not empty l_extra}"><style>${l_extra}</style>
</c:if></head>
<body<c:if test="${not empty l_body}"> class="${l_body}"</c:if>>
<c:if test="${not empty l_navbar}"><jsp:include page="/WEB-INF/jsp/includes/navbar.jsp">
  <jsp:param name="variant" value="${l_navbar}"/>
  <jsp:param name="home" value="${l_navhome}"/>
  <jsp:param name="navclass" value="${l_navclass}"/>
</jsp:include>
</c:if><c:if test="${l_cookie eq 'true'}"><jsp:include page="/WEB-INF/jsp/includes/cookie-notice.jsp"/>
</c:if><c:choose><c:when test="${not empty l_wrapper}"><div ${l_wrapper}>
  ${content}
</div>
</c:when><c:otherwise>${content}
</c:otherwise></c:choose><jsp:include page="/WEB-INF/jsp/includes/footer.jsp">
  <jsp:param name="parts" value="${l_parts}"/>
</jsp:include>
</body>
</html>
</c:otherwise></c:choose>