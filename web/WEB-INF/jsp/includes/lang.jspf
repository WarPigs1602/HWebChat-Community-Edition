<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%--
  Language detection shared by the public JSPs. Same order as the chat itself:
  "lang" cookie, "lang" request parameter, Accept-Language header (default: English).
  Sets the request-scoped variable "lang" ("de" or "en") and the JSTL locale/bundle.
--%><c:choose><c:when test="${not empty cookie.lang.value}"><c:set var="requestedLang" value="${cookie.lang.value}"/></c:when><c:when test="${not empty param.lang}"><c:set var="requestedLang" value="${param.lang}"/></c:when><c:when test="${fn:startsWith(fn:toLowerCase(header['Accept-Language']), 'de')}"><c:set var="requestedLang" value="de"/></c:when><c:otherwise><c:set var="requestedLang" value="en"/></c:otherwise></c:choose><c:set var="lang" value="${fn:toLowerCase(requestedLang) eq 'de' ? 'de' : 'en'}" scope="request"/><fmt:setLocale value="${lang}" scope="request"/><fmt:setBundle basename="i18n.messages" scope="request"/>
